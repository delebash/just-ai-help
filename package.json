{
  "name": "just-ai-help",
  "version": "0.1.0",
  "description": "Help-docs and translation tooling for any app that keeps its strings in standard i18n JSON. Translates a locale folder with an AI engine (local or online), and authors the help/hints system from the same source.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "just-ai-help": "./server/translate.js"
  },
  "scripts": {
    "translate": "node server/translate.js",
    "extract": "node server/extract.js",
    "review": "node server/review.js",
    "test": "node --test",
    "dev": "vite --config ui/vite.config.js",
    "build:ui": "vite build --config ui/vite.config.js && node scripts/ui-hash.js"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@tanstack/vue-table": "^8.21.3",
    "@vitejs/plugin-vue": "^6.0.0",
    "@vueuse/core": "^14.3.0",
    "marked": "^18.0.5",
    "pinia": "^3.0.1",
    "reka-ui": "^2.10.0",
    "vite": "^7.1.0",
    "vue": "^3.5.13",
    "vue-sonner": "^2.0.9"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "vue-demi@0.14.10": true
  }
}
