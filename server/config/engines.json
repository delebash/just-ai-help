{
  "gemini-free": {
    "kind": "openai-compat",
    "url": "https://generativelanguage.googleapis.com/v1beta/openai",
    "model": "gemini-3.6-flash",
    "apiKeyEnv": "GEMINI_API_KEY",
    "batchSize": 24,
    "rateLimitMs": 1000,
    "timeoutMs": 120000,
    "maxOutputTokens": 16000
  },
  "ollama": {
    "default": true,
    "kind": "ollama",
    "url": "http://127.0.0.1:11434",
    "model": "hf.co/unsloth/gemma-4-26B-A4B-it-qat-GGUF:UD-Q4_K_XL",
    "think": false,
    "batchSize": 16,
    "timeoutMs": 300000,
    "maxOutputTokens": 8192
  },
  "ollama-gemma3": {
    "kind": "ollama",
    "url": "http://127.0.0.1:11434",
    "model": "gemma3:12b",
    "batchSize": 16,
    "timeoutMs": 300000,
    "maxOutputTokens": 8192
  },
  "mistral": {
    "kind": "openai-compat",
    "url": "https://api.mistral.ai/v1",
    "model": "REQUIRED — pick one from docs.mistral.ai/getting-started/models, e.g. mistral-small-4-0-26-03",
    "apiKeyEnv": "MISTRAL_API_KEY",
    "batchSize": 24,
    "rateLimitMs": 1000,
    "timeoutMs": 120000,
    "maxOutputTokens": 16000
  },
  "openrouter": {
    "kind": "openai-compat",
    "url": "https://openrouter.ai/api/v1",
    "model": "REQUIRED — a catalogue slug like `meta-llama/llama-3.3-70b-instruct`; a `:free` suffix selects a free variant",
    "apiKeyEnv": "OPENROUTER_API_KEY",
    "batchSize": 24,
    "rateLimitMs": 1000,
    "timeoutMs": 120000,
    "maxOutputTokens": 16000
  },
  "local-openai-compatible": {
    "kind": "openai-compat",
    "url": "http://127.0.0.1:8080/v1",
    "model": "REQUIRED — the model id your server serves",
    "apiKeyEnv": "OPENAI_API_KEY",
    "batchSize": 8,
    "timeoutMs": 300000,
    "maxOutputTokens": 16000
  },
  "groq": {
    "kind": "openai-compat",
    "url": "https://api.groq.com/openai/v1",
    "model": "llama-3.3-70b-versatile",
    "apiKeyEnv": "GROQ_API_KEY",
    "batchSize": 24,
    "rateLimitMs": 2100,
    "timeoutMs": 120000,
    "maxOutputTokens": 16000
  },
  "openai": {
    "kind": "openai-compat",
    "url": "https://api.openai.com/v1",
    "model": "gpt-5.2",
    "apiKeyEnv": "OPENAI_API_KEY",
    "batchSize": 32,
    "rateLimitMs": 120,
    "timeoutMs": 120000,
    "maxOutputTokens": 16000
  }
}
