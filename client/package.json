    "vue": "^3.5.13",
    "vue-sonner": "^2.0.9"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "vite": "^7.1.0"
  },
  "allowScripts": {
    "esbuild@0.28.1": true,
    "vue-demi@0.14.10": true
  }
}
