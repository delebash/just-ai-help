node_modules/
just-ai-help.config.json
.jah-cache.json
*.log
.evidence/

# YOUR settings: engine connections and API KEYS. server/settings.js refuses to
# save a key unless this line is present, because "I assumed it was ignored" is
# how a key ends up published. Ignored also means `git pull` updates the tool
# and never touches your setup — and deleting this clone deletes your keys.
settings.json

# Per-project workshop state, written into the app being translated, never here.
# Listed so a stray copy in this repo is ignored too.
.jah-state.json

# The SQLite store this replaced on 2026-07-31. Kept ignored so an old working
# copy does not suddenly show a database as untracked.
.jah.db
.jah.db-journal
.jah.db-wal
.jah.db-shm

# ui/dist is COMMITTED on purpose — it is what lets the tool run with node
# alone: no install, no sibling checkout. node_modules is already ignored above.
